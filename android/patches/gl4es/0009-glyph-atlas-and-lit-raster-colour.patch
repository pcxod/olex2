+// The current raster colour is latched at glRasterPos, lit when GL_LIGHTING
+// is on (GL 1.x 2.13); glBitmap used whatever glColor was left over, and
+// Olex2 sets its font colours as materials, so text took a random colour.
+// ponytail: front face, no specular/attenuation/spot terms.
+static GLfloat raster_color[4] = {1.f, 1.f, 1.f, 1.f};
+static void raster_latch_color(const GLfloat *modelview, const GLfloat *eye) {
+	if (!glstate->enable.lighting) { memcpy(raster_color, glstate->color, 4*sizeof(GLfloat)); return; }
+	const material_t *m = &glstate->material.front;
+	const GLfloat *amb = m->ambient, *dif = m->diffuse;
+	if (glstate->enable.color_material) {
+		if (m->colormat==GL_AMBIENT || m->colormat==GL_AMBIENT_AND_DIFFUSE) amb = glstate->color;
+		if (m->colormat==GL_DIFFUSE || m->colormat==GL_AMBIENT_AND_DIFFUSE) dif = glstate->color;
+	}
+	GLfloat n[3], nn = 0.f;
+	for (int r=0; r<3; r++) {
+		n[r] = 0.f;
+		for (int k=0; k<3; k++) n[r] += modelview[r*4+k]*glstate->normal[k];
+		nn += n[r]*n[r];
+	}
+	nn = nn>0.f ? 1.f/sqrtf(nn) : 0.f;
+	for (int k=0; k<3; k++) {
+		GLfloat c = m->emission[k] + amb[k]*glstate->light.ambient[k];
+		raster_color[k] = c;
+	}
+	for (int i=0; i<MAX_LIGHT; i++) {
+		if (!glstate->enable.light[i]) continue;
+		const light_t *l = &glstate->light.lights[i];
+		GLfloat L[3], ll = 0.f, d = 0.f;
+		for (int k=0; k<3; k++) {
+			L[k] = l->position[k] - (l->position[3]!=0.f ? eye[k] : 0.f);
+			ll += L[k]*L[k];
+		}
+		ll = ll>0.f ? 1.f/sqrtf(ll) : 0.f;
+		for (int k=0; k<3; k++) d += n[k]*nn*L[k]*ll;
+		if (d < 0.f) d = 0.f;
+		for (int k=0; k<3; k++) raster_color[k] += amb[k]*l->ambient[k] + d*dif[k]*l->diffuse[k];
+	}
+	for (int k=0; k<3; k++) raster_color[k] = raster_color[k]>1.f ? 1.f : raster_color[k]<0.f ? 0.f : raster_color[k];
+	raster_color[3] = dif[3];
+}
