+static const char glyph_vsh[] = "#version 100\n"
+"attribute highp vec2 aPosition;\n"
+"attribute highp vec2 aTexCoord;\n"
+"attribute lowp vec4 aColor;\n"
+"varying mediump vec2 vTexCoord;\n"
+"varying lowp vec4 vColor;\n"
+"void main(){ gl_Position = vec4(aPosition, 0.0, 1.0); vTexCoord = aTexCoord; vColor = aColor; }\n";
+// same test as the CPU path's blit: unset bits and alpha 0 draw nothing
+static const char glyph_fsh[] = "#version 100\n"
+"uniform sampler2D uTex;\n"
+"varying mediump vec2 vTexCoord;\n"
+"varying lowp vec4 vColor;\n"
+"void main(){ if (texture2D(uTex, vTexCoord).a==0.0 || vColor.a==0.0) discard; gl_FragColor = vColor; }\n";
+
+// called by gl4es_blitTexture_gles2 for BLIT_GLYPHS, with its state pushed
+void raster_draw_glyphs() {
+	LOAD_GLES2(glUseProgram);
+	LOAD_GLES2(glVertexAttribPointer);
+	LOAD_GLES2(glEnableVertexAttribArray);
+	LOAD_GLES2(glDisableVertexAttribArray);
+	LOAD_GLES(glDrawArrays);
+	static GLuint prog;
+	if (!prog) {
+		LOAD_GLES2(glCreateShader); LOAD_GLES2(glShaderSource); LOAD_GLES2(glCompileShader);
+		LOAD_GLES2(glCreateProgram); LOAD_GLES2(glAttachShader); LOAD_GLES2(glBindAttribLocation);
+		LOAD_GLES2(glLinkProgram); LOAD_GLES2(glUniform1i); LOAD_GLES(glGetUniformLocation);
+		const char *src[2] = {glyph_vsh, glyph_fsh};
+		GLenum kind[2] = {GL_VERTEX_SHADER, GL_FRAGMENT_SHADER};
+		prog = gles_glCreateProgram();
+		for (int i=0; i<2; i++) {
+			GLuint s = gles_glCreateShader(kind[i]);
+			gles_glShaderSource(s, 1, &src[i], NULL);
+			gles_glCompileShader(s);
+			gles_glAttachShader(prog, s);
+		}
+		gles_glBindAttribLocation(prog, 0, "aPosition");
+		gles_glBindAttribLocation(prog, 1, "aTexCoord");
+		gles_glBindAttribLocation(prog, 2, "aColor");
+		gles_glLinkProgram(prog);
+		glstate->gleshard->program = prog;
+		gles_glUseProgram(prog);
+		gles_glUniform1i(gles_glGetUniformLocation(prog, "uTex"), 0);
+	}
+	if (glstate->gleshard->program != prog) {
+		glstate->gleshard->program = prog;
+		gles_glUseProgram(prog);
+	}
+	// attribs 0-2 from the queue; the cache in gleshard is kept honest so
+	// the next fpe draw re-sends what it needs (as realize_blitenv does)
+	unboundBuffers();
+	for (int i=0; i<hardext.maxvattrib; i++) {
+		vertexattrib_t *v = &glstate->gleshard->vertexattrib[i];
+		if (v->enabled != (i<3)) {
+			v->enabled = (i<3);
+			if (v->enabled) gles_glEnableVertexAttribArray(i); else gles_glDisableVertexAttribArray(i);
+		}
+		if (i<3) {
+			v->size = (i==2)?4:2;
+			v->type = (i==2)?GL_UNSIGNED_BYTE:GL_FLOAT;
+			v->normalized = (i==2);
+			v->stride = sizeof(glyphvtx_t);
+			v->pointer = (i==0)?(void*)&glyph_vtx->x:(i==1)?(void*)&glyph_vtx->u:(void*)glyph_vtx->c;
+			v->buffer = 0;
+			v->real_buffer = 0;
+			gles_glVertexAttribPointer(i, v->size, v->type, v->normalized, v->stride, v->pointer);
+		}
+	}
+	gles_glDrawArrays(GL_TRIANGLES, 0, glyph_nvtx);
+}
