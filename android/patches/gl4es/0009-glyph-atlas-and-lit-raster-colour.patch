+// Glyph atlas: glBitmap text (zoom 1, no pixel transfer, GLES2) is cached
+// once per distinct bitmap in a 512x512 texture and queued as one quad per
+// glyph; bitmap_flush draws the queue in a single call. The CPU path
+// rasterised every glyph into a viewport-sized buffer and uploaded its dirty
+// rect each frame, and console + legend made that rect most of the screen.
+// ponytail: one atlas for the process (single context); full -> flush + reset.
+#define ATLAS 512
+#define ATLAS_SLOTS 4096
+typedef struct { int w, h, ax, ay; GLubyte *bits; } glyph_t;
+typedef struct { GLfloat x, y, u, v; GLubyte c[4]; } glyphvtx_t;
+static glyph_t atlas_glyph[ATLAS_SLOTS];
+static int atlas_n, atlas_x, atlas_y, atlas_shelf, atlas_dirty0 = ATLAS, atlas_dirty1;
+static GLubyte *atlas_pix;	// RGBA mirror, uploaded by row band at flush
+static GLuint atlas_tex;
+static glyphvtx_t *glyph_vtx;
+static int glyph_nvtx, glyph_capvtx, bm_cpu;	// bm_cpu: CPU dirty rect in use
+
+static void atlas_reset() {
+	for (int i=0; i<ATLAS_SLOTS; i++) { free(atlas_glyph[i].bits); atlas_glyph[i].bits = NULL; }
+	atlas_n = atlas_x = atlas_y = atlas_shelf = 0;
+	memset(atlas_pix, 0, ATLAS*ATLAS*4);
+	atlas_dirty0 = 0; atlas_dirty1 = ATLAS;
+}
+
+// atlas slot of this bitmap, added if new; NULL when the atlas is full
+static glyph_t *atlas_get(int w, int h, const GLubyte *bitmap) {
+	int sz = ((w+7)/8)*h;
+	unsigned hs = 2166136261u;
+	hs = (hs^w)*16777619u; hs = (hs^h)*16777619u;
+	for (int i=0; i<sz; i++) hs = (hs^bitmap[i])*16777619u;
+	int i = hs & (ATLAS_SLOTS-1);
+	for (glyph_t *g; (g = &atlas_glyph[i])->bits; i = (i+1) & (ATLAS_SLOTS-1))
+		if (g->w==w && g->h==h && !memcmp(g->bits, bitmap, sz)) return g;
+	if (atlas_n >= ATLAS_SLOTS*3/4) return NULL;
+	if (atlas_x+w > ATLAS) { atlas_y += atlas_shelf+1; atlas_x = 0; atlas_shelf = 0; }
+	if (atlas_y+h > ATLAS) return NULL;
+	glyph_t *g = &atlas_glyph[i];
+	g->w = w; g->h = h; g->ax = atlas_x; g->ay = atlas_y;
+	g->bits = (GLubyte*)malloc(sz);
+	memcpy(g->bits, bitmap, sz);
+	for (int y=0; y<h; y++)
+		for (int x=0; x<w; x++)
+			if (bitmap[y*((w+7)/8)+x/8] & (1<<(7-x%8)))
+				memset(atlas_pix+4*(g->ax+x+(g->ay+y)*ATLAS), 255, 4);
+	atlas_dirty0 = min(atlas_dirty0, g->ay);
+	atlas_dirty1 = max(atlas_dirty1, g->ay+h);
+	atlas_x += w+1;
+	if (h > atlas_shelf) atlas_shelf = h;
+	atlas_n++;
+	return g;
+}
+
+// 1 when glBitmap could queue the glyph instead of rasterising it
+static int bitmap_atlas(GLsizei w, GLsizei h, GLfloat xorig, GLfloat yorig, const GLubyte *bitmap) {
+	if (hardext.esversion<2 || w>ATLAS || h>ATLAS || w<=0 || h<=0
+		|| glstate->raster.raster_zoomx!=1.f || glstate->raster.raster_zoomy!=1.f || raster_need_transform())
+		return 0;
+	if (!atlas_pix) { atlas_pix = (GLubyte*)malloc(ATLAS*ATLAS*4); atlas_reset(); }
+	glyph_t *g = atlas_get(w, h, bitmap);
+	if (!g) {
+		if (glstate->raster.bm_drawing) bitmap_flush();	// queued quads use the old UVs
+		atlas_reset();
+		g = atlas_get(w, h, bitmap);
+	}
+	if (glyph_nvtx+6 > glyph_capvtx) {
+		glyph_capvtx = glyph_capvtx*2 + 6*64;
+		glyph_vtx = (glyphvtx_t*)realloc(glyph_vtx, glyph_capvtx*sizeof(glyphvtx_t));
+	}
+	// same pixel snapping as the CPU path (int truncation), NDC of the current viewport
+	int rx = glstate->raster.rPos.x-xorig;
+	int ry = glstate->raster.rPos.y-yorig;
+	GLfloat w2 = 2.f/glstate->raster.viewport.width, h2 = 2.f/glstate->raster.viewport.height;
+	GLfloat x1 = rx*w2-1.f, x2 = (rx+w)*w2-1.f, y1 = ry*h2-1.f, y2 = (ry+h)*h2-1.f;
+	GLfloat u1 = g->ax/(GLfloat)ATLAS, u2 = (g->ax+w)/(GLfloat)ATLAS;
+	GLfloat v1 = g->ay/(GLfloat)ATLAS, v2 = (g->ay+h)/(GLfloat)ATLAS;
+	glyphvtx_t q[4] = {{x1,y1,u1,v1}, {x2,y1,u2,v1}, {x2,y2,u2,v2}, {x1,y2,u1,v2}};
+	static const int tri[6] = {0,1,2, 0,2,3};
+	for (int i=0; i<6; i++) {
+		glyphvtx_t *o = &glyph_vtx[glyph_nvtx++];
+		*o = q[tri[i]];
+		for (int k=0; k<4; k++) o->c[k] = raster_color[k]*255.f;
+	}
+	glstate->raster.bm_drawing = 1;
+	return 1;
+}
