+// GL_BAKE_HINT_GL4ES: modelview ops while compiling go to the bake stack, not into the list
+// op 0 push, 1 pop, 2 mult, 3 load (absolute, cannot be folded)
+static int bake_matrix(int op, const GLfloat *m) {
+	displaylist_state_t *l = &glstate->list;
+	if (!(l->compiling && l->bake)) return 0;
+	switch (op) {
+		case 0:
+			if (l->bake_top+1 < 16) {
+				memcpy(l->bake_mat[l->bake_top+1], l->bake_mat[l->bake_top], 16*sizeof(GLfloat));
+				++l->bake_top;
+			} else l->bake_failed = 1;
+			break;
+		case 1: if (l->bake_top) --l->bake_top; else l->bake_failed = 1; break;
+		case 2: matrix_mul(l->bake_mat[l->bake_top], m, l->bake_mat[l->bake_top]); break;
+		default: l->bake_failed = 1;
+	}
+	noerrorShim();
+	return 1;
+}
