+// GL_BAKE_HINT_GL4ES: inline the draws of list a with the baked MODELVIEW applied, vertices as M.v
+// and normals as M^-T.n (not renormalised, so GL_NORMALIZE sees the same lengths), so they merge
+// into few draws. Any other state in a sets bake_failed and the caller drops the list.
+renderlist_t* bake_calllist(renderlist_t *list, renderlist_t *a)
+{
+    displaylist_state_t *l = &glstate->list;
+    while(list->next) list = list->next;
+    GLfloat n[3];   // current normal, object space
+    memcpy(n, list->lastNormal, 3*sizeof(GLfloat));
+    for(; a && !l->bake_failed; a = a->next) {
+        if (a->raster_op || a->raster || a->bitmaps || a->pushattribute || a->popattribute
+         || a->material || a->colormat_face || a->light || a->lightmodel || a->texgen || a->texenv
+         || a->fog_op || a->pointparam_op || a->linestipple_op || a->render_op || a->instanceCount!=1
+         || a->set_texture || a->set_tmu || a->use_glstate || a->matrix_op==1) {
+            l->bake_failed = 1;
+            break;
+        }
+        for (unsigned long i=0; i<a->calls.len && !l->bake_failed; i++) {
+            packed_call_t *c = a->calls.calls[i];
+            if (c->func == (void*)gl4es_glNormal3f) {
+                PACKED_void_GLfloat_GLfloat_GLfloat *p = (PACKED_void_GLfloat_GLfloat_GLfloat*)c;
+                n[0] = p->args.a1; n[1] = p->args.a2; n[2] = p->args.a3;
+            } else if (c->func == (void*)gl4es_glPushMatrix || c->func == (void*)gl4es_glPopMatrix)
+                ((void (APIENTRY_GL4ES *)(void))c->func)();    // lands in bake_matrix
+            else
+                l->bake_failed = 1;
+        }
+        if (l->bake_failed) break;
+        GLfloat *M = l->bake_mat[l->bake_top];
+        if (a->matrix_op==2) matrix_mul(M, a->matrix_val, M);
+        if (a->len) {
+            renderlist_t *b = (renderlist_t*)malloc(sizeof(renderlist_t));
+            memcpy(b, a, sizeof(renderlist_t));
+            b->prev = b->next = NULL;
+            b->shared_calls = b->shared_arrays = b->shared_indices = NULL;
+            memset(&b->calls, 0, sizeof(call_list_t));
+            b->matrix_op = 0;
+            b->cap = a->len;
+            b->open = true;
+            b->stage = STAGE_DRAW;
+            b->vbo_array = b->vbo_indices = 0;
+            b->use_vbo_array = b->use_vbo_indices = 0;
+            b->vbo_vert = b->vbo_normal = b->vbo_color = b->vbo_secondary = b->vbo_fogcoord = NULL;
+            for (int i=0; i<MAX_TEX; i++) b->vbo_tex[i] = NULL;
+            b->ind_lines = NULL; b->ind_line = 0;
+            b->final_colors = NULL;
+            b->post_normal = 0;
+            if (a->vert) {
+                b->vert = alloc_sublist(4, a->len);
+                for (unsigned long i=0; i<a->len; i++) vector_matrix(a->vert+4*i, M, b->vert+4*i);
+            }
+            GLfloat r[9];
+            matrix_inverse3_transpose(M, r);
+            b->normal = alloc_sublist(3, a->len);
+            if (a->normal)
+                for (unsigned long i=0; i<a->len; i++) vector3_matrix3(a->normal+3*i, r, b->normal+3*i);
+            else {
+                GLfloat t[3];
+                vector3_matrix3(n, r, t);
+                for (unsigned long i=0; i<a->len; i++) memcpy(b->normal+3*i, t, 3*sizeof(GLfloat));
+            }
+            #define DUP(p, k) if (a->p) { b->p = alloc_sublist(k, a->len); memcpy(b->p, a->p, k*a->len*sizeof(GLfloat)); }
+            DUP(color, 4) DUP(secondary, 4) DUP(fogcoord, 1)
+            for (int i=0; i<a->maxtex; i++) { DUP(tex[i], 4) }
+            #undef DUP
+            if (a->indices) {
+                b->indices = (GLushort*)malloc(a->ilen*sizeof(GLushort));
+                memcpy(b->indices, a->indices, a->ilen*sizeof(GLushort));
+                b->indice_cap = a->ilen;
+            }
+            if (a->mode_inits) {
+                b->mode_inits = (modeinit_t*)malloc(a->mode_init_cap*sizeof(modeinit_t));
+                memcpy(b->mode_inits, a->mode_inits, a->mode_init_len*sizeof(modeinit_t));
+            }
+            if (islistscompatible_renderlist(list, b)) {
+                append_renderlist(list, b);
+                free_renderlist(b);
+            } else {
+                list->next = b;
+                b->prev = list;
+                list = b;
+            }
+        }
+        if (a->post_normal) memcpy(n, a->post_normals, 3*sizeof(GLfloat));
+    }
+    memcpy(list->lastNormal, n, 3*sizeof(GLfloat));
+    return list;
+}
