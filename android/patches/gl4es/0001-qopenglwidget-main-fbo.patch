+// The toolkit renders into its own FBO (QOpenGLWidget::defaultFramebufferObject)
+// and binds it behind gl4es's back: make gl4es map "framebuffer 0" onto it.
+// Call after every makeCurrent; the FBO stays owned by the toolkit.
+void gl4es_setMainFBO(GLuint fbo) {
+  if(glstate) glstate->fbo.mainfbo_fbo = fbo;
+}
+
 GLuint gl4es_getCurrentFBO() {
   return (glstate->fbo.current_fb->id)?glstate->fbo.current_fb->id:glstate->fbo.mainfbo_fbo;
 }
