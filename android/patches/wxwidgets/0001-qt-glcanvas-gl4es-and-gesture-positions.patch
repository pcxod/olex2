+#ifdef __ANDROID__
+// gl4es (desktop GL 1.x on GLES 2) when the application links it: it must be
+// initialised on a current context, has to treat the widget's FBO as
+// framebuffer 0 and holds back display lists and glBitmap batches until a
+// "swap". Weak, so an application without gl4es is unaffected.
+extern "C" {
+void initialize_gl4es() __attribute__((weak));
+void gl4es_setMainFBO(unsigned int fbo) __attribute__((weak));
+void gl4es_pre_swap() __attribute__((weak));
+void gl4es_post_swap() __attribute__((weak));
+void gl4es_resyncState() __attribute__((weak));
+}
+#endif
+
 class wxQtGLWidget : public wxQtEventSignalHandler< QOpenGLWidget, wxGLCanvas >
