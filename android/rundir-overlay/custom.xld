<reap help="Load a Crystallographic File (Android S1: no Python, so no spy calls; replaces the macro.xld reap)"
  <body
    <args
      <arg1 name="file name" def="">
      <arg2 name="options" def="">>
    <cmd
      <cmd0 "xgrid.Visible(false)">
      <cmd1 "if IsFileLoaded() then clear">
      <cmd2 "freeze true">
      <cmd3 "@reap %1 %2">
      <cmd4 "freeze false">
      <cmd5 "SetVar(SlideQPeaksVal,0)">
      <cmd6 "storeparam startup file.relativePath(filefull()) true">
      <cmd7 "html.Update">
    >
    <onabort
     <cmd "freeze false">
     <cmd "echo lasterror() -m=error">
> > >
